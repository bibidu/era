{
	email era-db@sslip.io
	# 裸 IP 走 HTTP（无备案）；禁止把 http://39.106.179.17 永久跳到 https
	auto_https disable_redirects
}

(cors_once) {
	@options method OPTIONS
	handle @options {
		header {
			Access-Control-Allow-Origin *
			Access-Control-Allow-Methods "GET,POST,PATCH,PUT,DELETE,OPTIONS"
			Access-Control-Allow-Headers "Authorization,apikey,Content-Type,Prefer,X-Client-Info,Range,X-Era-Auth"
			Access-Control-Expose-Headers "Content-Range,Preference-Applied"
			-Access-Control-Allow-Credentials
		}
		respond 204
	}
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET,POST,PATCH,PUT,DELETE,OPTIONS"
		Access-Control-Allow-Headers "Authorization,apikey,Content-Type,Prefer,X-Client-Info,Range,X-Era-Auth"
		Access-Control-Expose-Headers "Content-Range,Preference-Applied"
		-Access-Control-Allow-Credentials
	}
}

(api_routes) {
	handle /auth/* {
		reverse_proxy host.docker.internal:8793 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Expose-Headers
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Max-Age
		}
	}
	handle /rest/v1/* {
		reverse_proxy host.docker.internal:8793 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Expose-Headers
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Max-Age
		}
	}
	handle /rest/v1 {
		reverse_proxy host.docker.internal:8793 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Access-Control-Allow-Headers
			header_down -Access-Control-Expose-Headers
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Max-Age
		}
	}
	# 本机提取 / 临时治理任务服务（优先于旧 Supabase Functions 反代）
	handle /functions/v1/create-extract-task* {
		reverse_proxy host.docker.internal:8793 {
			transport http {
				dial_timeout 30s
				response_header_timeout 5m
				read_timeout 5m
				write_timeout 5m
			}
		}
	}
	handle /functions/v1/create-govern-task* {
		reverse_proxy host.docker.internal:8793 {
			transport http {
				dial_timeout 30s
				response_header_timeout 5m
				read_timeout 5m
				write_timeout 5m
			}
		}
	}
	# 旧 Supabase Edge Functions 同机反代：浏览器不直连美东，避免国内 Failed to fetch
	# /functions/v1/<name> → https://…functions.supabase.co/<name>
	handle /functions/v1/* {
		reverse_proxy host.docker.internal:8793 {
			transport http {
				dial_timeout 30s
				response_header_timeout 5m
				read_timeout 5m
				write_timeout 5m
			}
		}
	}
	handle /healthz {
		respond "ok" 200
	}
}

# 独立站 /apt/*：宿主机 /opt/apt-web → /srv/apt（勿被 Era SPA 吞掉）
(apt_routes) {
	handle /apt {
		redir * /apt/ 308
	}
	handle /apt/* {
		root * /srv
		encode gzip
		file_server
	}
}

# 独立站 /kuifou/*：宿主机 /opt/kuifou-web → /srv/kuifou（应用已拆到 bibidu/kuifou；Era 发版须保留本段）
(kuifou_routes) {
	handle /kuifou {
		redir * /kuifou/ 308
	}
	handle /kuifou/* {
		root * /srv
		header {
			Cache-Control "no-store, no-cache, must-revalidate"
			Pragma "no-cache"
		}
		encode gzip
		try_files {path} /kuifou/index.html
		file_server
	}
}

(spa_routes) {
	# /apt/* 来自独立目录 /opt/apt-web（compose 挂到 /srv/apt），禁止回落到 Era SPA
	handle /apt/* {
		root * /srv
		header {
			Cache-Control "no-store, no-cache, must-revalidate"
			Pragma "no-cache"
		}
		encode gzip
		file_server
	}
	handle {
		root * /srv
		encode gzip
		try_files {path} /index.html
		file_server
	}
}

# 公网 IP：前端 + REST（默认交付入口）
:80 {
	import cors_once
	import api_routes
	import apt_routes
	import kuifou_routes
	import spa_routes
}

# 兼容旧 REST 端口
:3000 {
	import cors_once
	import api_routes
	import apt_routes
	import kuifou_routes
	import spa_routes
}

