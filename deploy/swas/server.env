# 阿里云轻量自建站（SWAS）部署配置
# scripts/deploy-swas.sh 会 source 本文件，若存在再 source server.secrets.env

# ---- 实例 ----
SWAS_HOST=39.106.179.17
SWAS_USER=root
SWAS_REGION=cn-beijing
SWAS_INSTANCE_ID=75717399d2314904b18560857677c46e
SWAS_INSTANCE_NAME=OpenClaw-tpur

# ---- 路径 ----
SWAS_REPO_DIR=/opt/era
SWAS_WEB_DIR=/opt/era-web
SWAS_GIT_URL=https://github.com/bibidu/era.git
SWAS_GIT_BRANCH=main

# ---- SSH ----
SWAS_SSH_KEY=deploy/swas/id_rsa

# ---- OSS（非密钥）----
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=agent-17718139319
OSS_REGION=oss-cn-beijing
OSS_PREFIX=era/assets

# ---- 交付（HTTPS：Safari 可保存到相册；裸 IP HTTP 勿作默认）----
ERA_PUBLIC_BASE=https://39.106.179.17.sslip.io/

# AccessKey 放 server.secrets.env（见 server.secrets.env.example）
# Cloud Agent 亦可使用 Cursor Secrets / 环境变量 ALIYUN_ACCESS_KEY_ID|SECRET
